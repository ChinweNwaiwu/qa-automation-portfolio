{
  "info": {
    "_postman_id": "4783cc9e-89f0-4d36-99af-bbd875e04182",
    "name": "JSONPlaceholder QA Portfolio",
    "description": "Positive, creation, and negative contract checks for the public JSONPlaceholder API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get existing user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test('User contract contains required fields', () => {",
                  "  pm.expect(user.id).to.eql(1);",
                  "  pm.expect(user.name).to.be.a('string').and.not.empty;",
                  "  pm.expect(user.email).to.match(/^[^@]+@[^@]+\\.[^@]+$/);",
                  "  pm.expect(user.address.city).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/users/1"
          }
        },
        {
          "name": "Unknown user returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Response is an empty object', () => pm.expect(pm.response.json()).to.eql({}));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/users/999999"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const post = pm.response.json();",
                  "pm.test('Created resource echoes submitted values', () => {",
                  "  pm.expect(post.id).to.eql(101);",
                  "  pm.expect(post.title).to.eql('Quality is a team responsibility');",
                  "  pm.expect(post.userId).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Quality is a team responsibility\",\n  \"body\": \"Automated checks provide fast feedback.\",\n  \"userId\": 1\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/posts"
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "https://jsonplaceholder.typicode.com", "type": "string"}
  ]
}
